{
  "compilerOptions": {
    "module": "ESNext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": false,
    "strict": true,
    // Declaration files of build tooling (vite, rolldown) target newer lib
    // levels than this package; the subject of this gate is our code.
    "skipLibCheck": true,
    // svelte-package transpiles each module with this config, so this is the
    // published language level; the suite compiles with the same config, so
    // tests and artifact share one semantics.
    "target": "es2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    // Ambient rune declarations ($state, $derived) for the .svelte.ts modules.
    "types": ["node", "svelte"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "./src",
    "./tests",
    "./*.js",
    "./*.ts"
  ]
}