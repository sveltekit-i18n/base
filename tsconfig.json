{
  "compilerOptions": {
    "module": "ESNext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    // The `imports` map points into dist/, where the consumer's bundler picks
    // a target by condition; the source is what gets checked.
    "paths": {
      "#kit-env": ["./src/kit/env.ts"],
      "#kit-server": ["./src/kit/backend.ts"],
      // The benchmark imports the package by name, which its runner aliases
      // to the tree it measures.
      "@sveltekit-i18n/base": ["./src/index.ts"],
      "@sveltekit-i18n/base/kit": ["./src/exports/kit.ts"]
    },
    "sourceMap": false,
    "strict": true,
    // Declaration files of build tooling (vite, rolldown) target newer lib
    // levels than this package; the subject of this gate is our code.
    "skipLibCheck": true,
    // svelte-package transpiles each module with this config, so this is the
    // published language level; the suite compiles with the same config, so
    // tests and artifact share one semantics.
    "target": "es2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    // Ambient rune declarations ($state, $derived) for the .svelte.ts modules.
    "types": ["node", "svelte"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "./src",
    "./tests",
    "./*.js",
    "./*.ts"
  ],
  // Programs of their own, each with its own registration: one here would
  // type every schema-less instance in the suite. The benchmark is checked by
  // bench/tsconfig.json.
  "exclude": ["./tests/types"]
}